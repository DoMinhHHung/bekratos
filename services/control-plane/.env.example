HOST=0.0.0.0
PORT=8081
DATABASE_URL=postgres://bekratos:bekratos@localhost:5433/control_plane
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
READINESS_TIMEOUT=2s
MIGRATE_ON_STARTUP=false

IDENTITY_JWKS_URL=http://localhost:8080/v1/jwks
IDENTITY_INTROSPECTION_URL=http://localhost:8080/internal/v1/identity/introspect
IDENTITY_SERVICE_API_TOKEN=replace-with-the-same-random-secret-in-Identity-and-Control-Plane
IDENTITY_HTTP_TIMEOUT=2s
JWT_ISSUER=https://identity.bekratos.local
JWT_AUDIENCE=bekratos-api
JWKS_CACHE_TTL=60s
JWKS_HTTP_TIMEOUT=3s
JWT_LEEWAY=30s
MAX_REVOCATION_DELAY=15m

# Leave blank to keep deployment fail-closed until the Runtime API exists.
RUNTIME_API_URL=
RUNTIME_API_TOKEN=
RUNTIME_HTTP_TIMEOUT=25s

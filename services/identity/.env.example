HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_URL_TEST=postgresql://user:password@host:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
REQUEST_TIMEOUT_SECS=30
BODY_LIMIT_BYTES=1048576
READINESS_REQUIRE_DB=false
READINESS_REQUIRE_REDIS=false
RUST_LOG=info

# HMAC keyring for magic links (hex-encoded 32+ bytes). Active key first.
# Format: kid1:hexsecret1,kid2:hexsecret2
MAGIC_LINK_HMAC_KEYS=v1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MAGIC_LINK_ACTIVE_KID=v1

# Public base URL used when building magic links (no trailing slash)
APP_PUBLIC_BASE_URL=http://localhost:8080

# Mail: console | none | resend
MAIL_PROVIDER=console
MAIL_FROM=noreply@example.com
MAIL_API_KEY=
MAIL_API_BASE_URL=https://api.resend.com
MAIL_TIMEOUT_SECS=10

# Shared secret for the private Identity introspection API; keep empty to disable it.
IDENTITY_SERVICE_API_TOKEN=

# Argon2id (override only after benchmark on target hardware)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENT=2

JWT_KID=es256-1
JWT_ISSUER=https://identity.bekratos.local
JWT_AUDIENCE=bekratos-api
JWT_ACCESS_TTL_SECS=900
REFRESH_TTL_SECS=2592000
SESSION_TTL_SECS=2592000

JWT_KEY_ENCRYPTION_KEY=replace-with-high-entropy-secret-at-least-32-chars
JWKS_CACHE_TTL_SECS=60
